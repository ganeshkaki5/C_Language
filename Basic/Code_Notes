// rev a bits in a given number
#include<stdio.h>
int main()
{
    int num,i,j,m,n,r;
    printf("Enter the number:\n");
    scanf("%d",&num);

    printf("before swap bianry format:\n");
    for(i=8;i>=0;i--)
        printf("%d ", r= num>>i&1);

    printf("\n");

    for(i=0,j=8;i<j;i++,j--)
    {
        m = num>>i&1;
        n = num>>j&1;
        if(m!=n)
        {
            num = num ^ (1<<i);
            num = num ^ (1<<j);
        }
    }

    printf("After swap of two numbers:\n");

    for(i=8;i>=0;i--)
        printf("%d ",num>>i&1);

    printf("\n");
    return 0;
}
