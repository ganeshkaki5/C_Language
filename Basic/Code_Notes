//WAP to shuffle negative numbers and positive numbers in an array
#include<stdio.h>
int main()
{
    int arr[]={1,-2,-3,0,-4,6,4,2};
    int n = sizeof(arr)/sizeof(arr[0]);
    int rel[n];
    int i,j;
    //positive numbers to store.
    for(i=0;i<n;i++)
    {
        if(arr[i]>=0)
         rel[j++] = arr[i];
    }
    //negative numbers to store
    for(i=0;i<n;i++)
    {
        if(arr[i]<0)
        rel[j++] = arr[i];
    }
    //assign the sorted values into arr[n]
    for(i=0;i<n;i++)
    {
        arr[i] = rel[i];
    }

    //print the sorted array
    for(i=0;i<n;i++)
    {
        printf("%d ",arr[i]);
    }

    return 0;
}


