// Logic to find out power of any number
#include<stdio.h>
int main()
{
    int a,b;
    int rel = 1;
    printf("Enter the a and b:\n");
    scanf("%d %d",&a,&b);
    if(b>=0)
    {
        int i;
        for(i=0;i<b;i++)
         rel = rel * a;
    }
    printf("a %d ^ b %d = rel %d \n",a,b,rel);
    return 0;
}