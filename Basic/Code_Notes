// bubble Sort
#include<stdio.h>
int main()
{
    int i,j,t,ele;
    int a[5]={50,75,35,20,10};
    ele = sizeof(a)/sizeof(a[0]);
     
    for(i-0;i<ele-1;i++)
    {
        for(j=0;j<ele-1-i;j++)
        {
            if(a[j]>a[j+1])
            {
                t=a[j];
                a[j]=a[j+1];
                a[j+1]=t;
            }
        }
    }
   for(i=0;i<ele;i++)
   printf("%d ",a[i]);

    return 0;
}
