// WAP recursive to find the length of the code
#include<stdio.h>
int print(const char *s)
{
    static int i=0;
    if(s[i])
    {
        i++;
        print(s);
    }
    return i;
}

int main()
{
    char s[10];
    int i;
    printf("Enter the string:\n");
    scanf("%s",s);
    i= print(s);

    printf("Str len:%d\n",i);

    return 0;
}

