// WAP factorial of a given number
#include<stdio.h>
int fact(int num)
{
    static int ret =0;
     if(num == 0)
        ret =1;
     else
       ret = num* fact(num-1);

    return ret;
}

int main()
{
    int num,rel;
    printf("Enter the number:\n");
    scanf("%d",&num);
 
    rel = fact(num);   

    printf("fact results: %d",rel);

    return 0;
}


